{
  "description": "Demo hooks",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh\"", "timeout": 10 }
        ]
      },
      {
        "matcher": "startup|resume",
        "hooks": [ { "type": "command", "command": "echo started" } ]
      },
      {
        "matcher": "compact",
        "hooks": [ { "type": "command", "command": "echo compacted" } ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "echo '{}'" },
          { "type": "prompt", "prompt": "Is this safe?" },
          { "type": "command", "command": "true", "if": "Bash(git push *)" }
        ]
      }
    ],
    "Notification": [
      { "hooks": [ { "type": "command", "command": "true" } ] }
    ]
  }
}
